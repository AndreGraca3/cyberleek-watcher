# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Upstash Redis for cloud state persistence (optional, for Render deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# State storage configuration
STATE_KEY=cyberleek:state
LOCAL_STATE_PATH=./data/state.json

# Logging
LOG_LEVEL=info

# Spoiler filter: when true, leak titles containing any SPOILER_KEYWORDS
# (comma-separated, case-insensitive) are announced with a spoiler-safe
# embed instead of an auto-unfurled direct video link.
SPOILER_FILTER_ENABLED=false
SPOILER_KEYWORDS=ending,epilogue,finale,final mission

# Fallback only: primary signal is the poll account's data stabilizing (no
# changes across consecutive checks). If it never stabilizes, notify anyway
# this many seconds after closesAt.
POLL_CLOSE_GRACE_SECONDS=1800

# Cooldown after closesAt before comparing consecutive reads for stability,
# to avoid mistaking "nothing processed yet" for "processing finished".
POLL_SETTLE_MIN_DELAY_SECONDS=240
