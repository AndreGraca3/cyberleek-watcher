# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Upstash Redis for cloud state persistence (optional, for Render deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# State storage configuration
STATE_KEY=cyberleek:state
LOCAL_STATE_PATH=./data/state.json

# Filebase (optional): S3-compatible bucket used to mirror resolved direct
# video links before they're posted to Discord. Leave unset to skip
# mirroring entirely (original mirror links are used as-is). Downloads are
# best-effort — if the source host blocks/rate-limits the download, the
# watcher silently falls back to the original link instead of failing the alert.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
FILEBASE_ENDPOINT=https://s3.filebase.com
# Per-video cap and download timeout for Filebase mirroring. Downloads for
# multiple mirror items in the same leak run in parallel and are each
# buffered fully in memory, so keep FILEBASE_MAX_VIDEO_MB well under your
# Render instance's RAM (free tier is ~512MB). The timeout only bounds how
# long the watcher waits before giving up on a single slow mirror host and
# falling back to the original link — it does not affect the videos below it.
FILEBASE_MAX_VIDEO_MB=200
FILEBASE_DOWNLOAD_TIMEOUT_MS=45000
# How long the generated mirror URL stays valid. Filebase buckets are private
# by default (public bucket policies require a paid plan), so mirror links
# are presigned S3 GET URLs rather than plain public links. Capped at 604800
# (7 days), the SigV4 maximum.
FILEBASE_URL_EXPIRY_SECONDS=604800

# /test-video live-test endpoint (optional): posts to this webhook instead of
# DISCORD_WEBHOOK_URL, and (when set) requires a matching `?token=` query
# param to guard against unauthenticated Filebase/bandwidth/webhook use.
TEST_DISCORD_WEBHOOK_URL=
TEST_ENDPOINT_TOKEN=

# Logging
LOG_LEVEL=info

# Spoiler filter: when true, leak titles containing any SPOILER_KEYWORDS
# (comma-separated, case-insensitive) are announced with a spoiler-safe
# embed instead of an auto-unfurled direct video link.
SPOILER_FILTER_ENABLED=false
SPOILER_KEYWORDS=ending,epilogue,finale,final mission

# Fallback only: primary signal is the poll account's data stabilizing (no
# changes across consecutive checks). If it never stabilizes, notify anyway
# this many seconds after closesAt.
POLL_CLOSE_GRACE_SECONDS=1800

# Cooldown after closesAt before comparing consecutive reads for stability,
# to avoid mistaking "nothing processed yet" for "processing finished".
POLL_SETTLE_MIN_DELAY_SECONDS=240
